{
  "id": "open-sub-account",
  "version": 1,
  "name": "Open Sub-Account",
  "description": "Looks up a member by ID and opens a new sub-account (savings or checking) with a given initial deposit, confirms it, and reports back the confirmation message. Precondition: the caller already has an authenticated session against the target app.",
  "target": {
    "baseUrl": "http://localhost:4000",
    "entryPath": "/search"
  },
  "inputSchema": {
    "memberId": {
      "type": "string",
      "description": "Member ID to search for and open the sub-account under"
    },
    "accountType": {
      "type": "string",
      "description": "Sub-account type to open",
      "enum": [
        "savings",
        "checking"
      ]
    },
    "initialDeposit": {
      "type": "string",
      "description": "Initial deposit amount in whole/decimal dollars (minimum $25)"
    }
  },
  "outputSchema": {
    "confirmationMessage": {
      "type": "string",
      "description": "Raw confirmation text shown after the sub-account is created"
    }
  },
