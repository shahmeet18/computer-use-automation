{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation system: LLM discovery -> reusable capability artifact -> deterministic replay, for legacy back-office banking apps.",
  "type": "module",
  "scripts": {
    "dev:target-app": "tsx watch src/target-app/server.ts",
    "typecheck": "tsc --noEmit",
